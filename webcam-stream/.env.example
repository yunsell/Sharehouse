# 이 파일을 .env로 복사한 뒤 값을 채우세요 (.env는 git에 올라가지 않습니다)
# 접속 비밀번호 (필수, 6자 이상). 비어 있으면 서버가 시작되지 않습니다.
WEBCAM_PASSWORD=

# 선택 항목
# 터널을 쓰면 127.0.0.1을 그대로 두세요. 외부에서 직접 접근할 수 없어 안전합니다.
HOST=127.0.0.1
PORT=5177
# 웹캠 번호 (보통 0)
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS=15
# JPEG 품질 (1~100, 높을수록 선명하고 데이터를 많이 사용)
JPEG_QUALITY=70
# 동시 시청 인원
MAX_VIEWERS=3
# 로그인 유지 시간
SESSION_HOURS=12
